@@ -1,3 +1,5 @@
+@use "lib/viewport";
+
 html.discourse-reactions-no-select {
   -webkit-touch-callout: none; /* Disables long-touch menu */
 
@@ -299,3 +301,85 @@ nav.post-controls .actions .reaction-button:focus {
 nav.post-controls .actions .reaction-button {
   margin: 0;
 }
+
+// Riverside: opt-in display overlay; disabled leaves official styles unchanged.
+nav.post-controls:has(.rs-reaction-counts-enabled) {
+  gap: 0.5em;
+
+  .reactions-actions-summary {
+    flex: 1 1 0;
+    min-width: 0;
+  }
+
+  .reactions-actions-summary .discourse-reactions-actions {
+    display: flex;
+    width: 100%;
+    min-width: 0;
+  }
+
+  > .actions {
+    flex: 0 0 auto;
+  }
+
+  &.expanded {
+    flex-wrap: wrap;
+
+    .reactions-actions-summary {
+      flex-basis: 100%;
+    }
+
+    > .actions {
+      flex-wrap: wrap;
+      justify-content: flex-end;
+      max-width: 100%;
+    }
+  }
+}
+
+.discourse-reactions-counter.rs-reaction-counts-enabled {
+  --rs-reaction-max-rows: 1;
+  min-width: 0;
+  width: 100%;
+  justify-content: flex-start;
+
+  @include viewport.until(sm) {
+    --rs-reaction-max-rows: 2;
+  }
+
+  .discourse-reactions-list {
+    min-width: 0;
+    width: 100%;
+    justify-content: flex-start;
+  }
+
+  .discourse-reactions-list .reactions {
+    width: 100%;
+    min-width: 0;
+    flex-wrap: wrap;
+    gap: 0.25em 0.5em;
+
+    .discourse-reactions-list-emoji,
+    .rs-reaction-overflow {
+      flex: 0 0 auto;
+      white-space: nowrap;
+      gap: 0.25em;
+      padding: 0.2em 0;
+    }
+
+    .discourse-reactions-list-emoji:nth-of-type(1n + 4) {
+      display: flex;
+    }
+
+    [hidden] {
+      display: none !important;
+    }
+  }
+
+  .rs-reaction-overflow {
+    color: var(--primary-medium);
+  }
+
+  .reactions-counter {
+    display: none;
+  }
+}
