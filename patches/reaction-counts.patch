diff --git a/plugins/discourse-reactions/assets/javascripts/discourse/modifiers/reaction-filter-scroll.js b/plugins/discourse-reactions/assets/javascripts/discourse/modifiers/reaction-filter-scroll.js
new file mode 100644
index 0000000..ddaa197
--- /dev/null
+++ b/plugins/discourse-reactions/assets/javascripts/discourse/modifiers/reaction-filter-scroll.js
@@ -0,0 +1,72 @@
+import { modifier } from "ember-modifier";
+
+export default modifier((element, [enabled, activeFilter, reactions]) => {
+  if (!enabled || !reactions?.length) {
+    return;
+  }
+  const tabs = element.querySelector(".users-popup__header");
+  const previous = element.querySelector(".rs-filter-prev");
+  const next = element.querySelector(".rs-filter-next");
+  if (!tabs || !previous || !next) {
+    return;
+  }
+  let frame;
+  const buttons = () => [...tabs.querySelectorAll("[data-reaction-filter]")];
+  const update = () => {
+    const rect = tabs.getBoundingClientRect();
+    const rects = buttons().map((button) => button.getBoundingClientRect());
+    previous.disabled = !rects.some((r) => r.left < rect.left - 1);
+    next.disabled = !rects.some((r) => r.right > rect.right + 1);
+  };
+  const reveal = (button) => {
+    if (!button) {
+      return;
+    }
+    const rect = tabs.getBoundingClientRect();
+    const target = button.getBoundingClientRect();
+    if (target.left < rect.left) {
+      tabs.scrollLeft += target.left - rect.left;
+    } else if (target.right > rect.right) {
+      tabs.scrollLeft += target.right - rect.right;
+    }
+    update();
+  };
+  const resize = () => {
+    cancelAnimationFrame(frame);
+    frame = requestAnimationFrame(() => {
+      reveal(
+        buttons().find(
+          (b) => b.dataset.reactionFilter === (activeFilter || "all")
+        )
+      );
+      update();
+    });
+  };
+  const click = (event) => {
+    const direction = event.target.closest(".rs-filter-prev")
+      ? -1
+      : event.target.closest(".rs-filter-next")
+        ? 1
+        : 0;
+    if (direction) {
+      event.preventDefault();
+      event.stopPropagation();
+      tabs.scrollBy({ left: direction * tabs.clientWidth * 0.75 });
+    }
+  };
+  const focus = (event) =>
+    reveal(event.target.closest("[data-reaction-filter]"));
+  const observer = new ResizeObserver(resize);
+  observer.observe(tabs);
+  tabs.addEventListener("scroll", update, { passive: true });
+  tabs.addEventListener("focusin", focus);
+  element.addEventListener("click", click);
+  resize();
+  return () => {
+    cancelAnimationFrame(frame);
+    observer.disconnect();
+    tabs.removeEventListener("scroll", update);
+    tabs.removeEventListener("focusin", focus);
+    element.removeEventListener("click", click);
+  };
+});
diff --git a/plugins/discourse-reactions/assets/javascripts/discourse/modifiers/reaction-overflow.js b/plugins/discourse-reactions/assets/javascripts/discourse/modifiers/reaction-overflow.js
new file mode 100644
index 0000000..8794f74
--- /dev/null
+++ b/plugins/discourse-reactions/assets/javascripts/discourse/modifiers/reaction-overflow.js
@@ -0,0 +1,98 @@
+import { modifier } from "ember-modifier";
+import { i18n } from "discourse-i18n";
+
+// Own only the hidden attributes and the empty overflow label. Glimmer still
+// owns reaction rendering, including live updates and custom emoji images.
+export default modifier((element, [enabled, reactions, total]) => {
+  if (
+    !enabled ||
+    !reactions?.length ||
+    !total ||
+    !element.closest(".rs-reaction-counts-enabled")
+  ) {
+    return;
+  }
+
+  let frame;
+  let disposed = false;
+  const measure = () => {
+    const overflow = element.querySelector(".rs-reaction-overflow");
+    if (!overflow || !element.isConnected || element.clientWidth === 0) {
+      return;
+    }
+    const items = Array.from(element.children).filter((child) =>
+      child.classList.contains("discourse-reactions-list-emoji")
+    );
+    items.forEach((item) => (item.hidden = false));
+    overflow.hidden = true;
+
+    const style = getComputedStyle(element);
+    const gap = parseFloat(style.columnGap) || 0;
+    const maxRows =
+      parseInt(style.getPropertyValue("--rs-reaction-max-rows"), 10) || 1;
+    const available = element.getBoundingClientRect().width;
+    const widths = items.map((item) => item.getBoundingClientRect().width);
+    // Prefix packing lets us reserve space for a variable-width +N label
+    // without guessing emoji widths, font size, or the number of digits.
+    const prefixes = [{ row: 1, used: 0 }];
+    const append = ({ row, used }, width) => {
+      if (used && used + gap + width > available) {
+        return { row: row + 1, used: width };
+      }
+      return { row, used: used ? used + gap + width : width };
+    };
+    widths.forEach((width) => prefixes.push(append(prefixes.at(-1), width)));
+    if (
+      prefixes.at(-1).row <= maxRows &&
+      widths.every((width) => width <= available)
+    ) {
+      return;
+    }
+
+    overflow.hidden = false;
+    let visible = items.length - 1;
+    for (; visible >= 0; visible--) {
+      const count = items.length - visible;
+      overflow.textContent = `⋯ +${count}`;
+      const end = append(
+        prefixes[visible],
+        overflow.getBoundingClientRect().width
+      );
+      if (end.row <= maxRows && end.used <= available) {
+        break;
+      }
+    }
+    visible = Math.max(0, visible);
+    const count = items.length - visible;
+    overflow.textContent = `⋯ +${count}`;
+    overflow.title = i18n("discourse_reactions.overflow_title", { count });
+    items.forEach((item, index) => (item.hidden = index >= visible));
+  };
+  const schedule = () => {
+    cancelAnimationFrame(frame);
+    if (!disposed) {
+      frame = requestAnimationFrame(measure);
+    }
+  };
+  let previousWidth;
+  const observer = new ResizeObserver(([entry]) => {
+    if (entry.contentRect.width !== previousWidth) {
+      previousWidth = entry.contentRect.width;
+      schedule();
+    }
+  });
+  observer.observe(element);
+  window.addEventListener("resize", schedule);
+  document.fonts?.ready.then(schedule);
+  schedule();
+
+  return () => {
+    disposed = true;
+    cancelAnimationFrame(frame);
+    observer.disconnect();
+    window.removeEventListener("resize", schedule);
+    element
+      .querySelectorAll(".discourse-reactions-list-emoji")
+      .forEach((item) => (item.hidden = false));
+  };
+});
